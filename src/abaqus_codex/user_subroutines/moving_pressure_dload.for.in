C     初学者三维路面示例的移动矩形压力。
C     下列数值由通过校验的 JSON 配置自动写入。
      SUBROUTINE DLOAD(F,KSTEP,KINC,TIME,NOEL,NPT,LAYER,KSPT,
     1 COORDS,JLTYP,SNAME)
      INCLUDE 'ABA_PARAM.INC'
      DIMENSION TIME(2),COORDS(3)
      CHARACTER*80 SNAME
      DOUBLE PRECISION PRESSURE,SPEED,HALFLEN,HALFWID
      DOUBLE PRECISION CENTERY,XSTART,XCENTER

      PRESSURE=@LOAD_PRESSURE@
      SPEED=@LOAD_SPEED@
      HALFLEN=@LOAD_HALF_LENGTH@
      HALFWID=@LOAD_HALF_WIDTH@
      CENTERY=@LOAD_CENTER_Y@
      XSTART=@LOAD_START_X@
      XCENTER=XSTART+SPEED*TIME(2)

C     Abaqus 中正压力方向指向实体内部，因此返回正的压力大小。
      F=0.D0
      IF (DABS(COORDS(1)-XCENTER).LE.HALFLEN .AND.
     1    DABS(COORDS(2)-CENTERY).LE.HALFWID) THEN
         F=PRESSURE
      END IF

      RETURN
      END
